<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8">
        <link rel="stylesheet" href="/style.css">
        <title>thinger</title>
    </head>

    <body>
        <header>
            {{#if user}}
            <h1 class="hN"> greetings, {{user.name}} </h1>
            <h2 class="hN"> balance: {{user.points}}p </h2>
            {{else}}
            <h1 class="hN"> home </h1>
            {{/if}}
            <hr>
            {{#if user}}
                <a href="/send">send points</a> | 
                <a href="/moves/incoming">incoming</a> | 
                <a href="/moves/outgoing">outgoing</a> | 
                <a href="/moves/past">past</a> | 
                <a href="logout">logout</a>
                {{#if user.admin}} | <a href="/admin">admin</a>{{/if}}
            {{else}}
                <a href="/login">login</a>
                <a href="/register">register</a>
            {{/if}}
            <hr>
        </header>
        <footer>
            {{#if error_text}}
                <p>{{error_text}}</p>
            {{/if}}
        </footer>
    </body>

    <script>
        // For debugging purposes.
        console.log(document.cookie)
    </script>
</html>
