<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8">
        <link rel="stylesheet" href="/style.css">
        <title>thinger</title>
    </head>

    <body>
        <header>
            <h1 class="hN"> admin </h1>
            <hr>
            <a href="/">home</a>
            <hr>
        </header>
        <main>
            <table>
                <tr>
                    <th>from</th>
                    <th>to</th>
                    <th>amount</th>
                    <th>message</th>
                    <th>date</th>
                    {{#if show_status}}
                        <th>status</th>
                    {{/if}}
                    {{#if can_accept}}
                        <th>accept</th>
                    {{/if}}
                    {{#if can_cancel}}
                        <th>cancel</th>
                    {{/if}}
                </tr>
                {{#each moves}}
                    <tr>
                        <td>{{sender}}</td>
                        <td>{{receiver}}</td>
                        <td>{{amount}}</td>
                        <td>{{message}}</td>
                        <td>{{date}}</td>
                        <td>{{status}}</td>
                        {{#if editable}}
                            <td>
                                <a href="/update/accept/admin/{{id}}">accept</a>
                            </td>
                            <td>
                                <a href="/update/cancel/admin/{{id}}">cancel</a>
                            </td>
                        {{else}}
                            <td>-</td>
                            <td>-</td>
                        {{/if}}
                    </tr>
                {{/each}}
            </table>
        </main>
        <footer>
            {{#if error_text}}
                <p>{{error_text}}</p>
            {{/if}}
        </footer>
    </body>

    <script>
        // For debugging purposes.
        console.log(document.cookie)
    </script>
</html>
